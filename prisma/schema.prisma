datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//Models for MySQL DB

//accounts

model Client {
  id        String   @id
  password  String
  phone     String   @unique @db.VarChar(20)
  name      String   @db.VarChar(90)
  avatar    String   @default("")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Executor {
  id        String   @id
  password  String
  phone     String   @unique @db.VarChar(20)
  name      String   @db.VarChar(90)
  avatar    String   @default("")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}
